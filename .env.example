# ---------------------------------------------------------------------------
# Ambiente: dev | producao. Em producao, JWT_SECRET, ADMIN_SENHA_INICIAL e
# ROTULAGEM_SALT com os valores de exemplo abaixo (ou vazios) impedem a API de subir.
# ---------------------------------------------------------------------------
AMBIENTE=dev

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
POSTGRES_USER=inspecao
POSTGRES_PASSWORD=inspecao_dev
POSTGRES_DB=inspecao
# porta exposta no host (o container segue em 5432). Se outra instancia ja ocupar a
# porta, mude AQUI e tambem a porta em DATABASE_URL abaixo.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://inspecao:inspecao_dev@localhost:5432/inspecao

# ---------------------------------------------------------------------------
# Armazenamento local (sem nuvem)
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage

# ---------------------------------------------------------------------------
# Ingestao
# ---------------------------------------------------------------------------
INGEST_SOURCE=batch_folder
INGEST_STAGING_DIR=./data/staging
INGEST_NOTAS_XLSX=./Base cliente/DESCRIÇÃO NOTAS LEITURISTAS X SOLICITAÇÃO DE FOTO.xlsx

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
AUTH_PROVIDER=local_password
JWT_SECRET=trocar_em_producao_use_openssl_rand_hex_32
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
ADMIN_SENHA_INICIAL=trocar_no_primeiro_login
ADMIN_EMAIL=admin@exemplo.com.br
# cookie do refresh token com flag Secure. Navegadores aceitam em http://localhost.
COOKIE_SECURE=true
# aceitar X-Forwarded-For (so atras de proxy confiavel; o compose liga para a api)
CONFIAR_X_FORWARDED_FOR=false

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_SEGUNDOS=2
WORKER_MAX_TENTATIVAS=3

# ---------------------------------------------------------------------------
# Modelos
# ---------------------------------------------------------------------------
# Detector do worker antes do modelo treinado: heuristica (M5) ou nulo (tudo para a fila humana).
DETECTOR_QUALIDADE=heuristica
MODELO_QUALIDADE_PATH=./ml/artifacts/qualidade.onnx
MODELO_QUALIDADE_ATIVO=false

# ---------------------------------------------------------------------------
# Rotulagem (M6)
# ---------------------------------------------------------------------------
# Salt secreto da ordem em que cada rotulador recebe as fotos. Sem ele a ordem e
# calculavel a partir dos ids. Em producao gere outro: openssl rand -hex 16
ROTULAGEM_SALT=9b846d587d76561b49133bcbd9da8808
