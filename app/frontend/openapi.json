        {
         "type": "null"
        }
       ],
       "title": "Excluir"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/LeituraOut"
